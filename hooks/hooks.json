{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*github.*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/scripts/scope_guard.py",
              "${CLAUDE_PLUGIN_DATA}/scope.json"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__.*entityos.*__([Ww]rite|[Uu]pdate|[Cc]reate|[Dd]elete|[Pp]ut|[Rr]emove|[Ii]nsert|[Uu]psert|[Pp]atch|[Mm]erge).*$",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-c",
              "import json;print(json.dumps({\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"ask\",\"permissionDecisionReason\":\"LifeOS: this writes to EntityOS. Confirm what is stored or changed (see risk-check).\"}}))"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebFetch|WebSearch|mcp__.*entityos.*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/scripts/data_guard.py",
              "${CLAUDE_PLUGIN_ROOT}/scripts/screen_text.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/scripts/log_guard.py"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
